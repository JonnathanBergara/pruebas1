# Cabeceras de seguridad para despliegues Apache.
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'none'; style-src 'self'; img-src 'self' https://images.unsplash.com data:; font-src 'self'; form-action 'self'; upgrade-insecure-requests"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

# Evita exponer archivos de control o configuración.
<FilesMatch "^(\.git|\.env|\.htaccess|\.DS_Store|package(-lock)?\.json)$">
    Require all denied
</FilesMatch>

Options -Indexes